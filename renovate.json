{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
        "customType": "regex",
        "datasourceTemplate": "github-releases",
        "managerFilePatterns": [
            "/^.github/workflows/release.yaml$/"
        ],
        "matchStrings": [
            "ref:\\s+(?<currentValue>.*?)\\n\\s+repository:\\s+(?<depName>.*?)\\n"
        ]
    }
  ],
  "extends": [
    "github>marinatedconcrete/config//renovate/marinatedconcrete#renovate-config-2.3.0",
    "github>marinatedconcrete/config//renovate/recommended#renovate-config-2.3.0"
  ],
  "packageRules": [
    {
        "automerge": true,
        "automergeType": "branch",
        "description": "Automatic Bazzite Kernel Updates",
        "matchPackageNames": [
            "bazzite-org/kernel-bazzite"
        ],
        "minimumReleaseAge": "1 day"
    },
    {
        "automerge": true,
        "automergeType": "branch",
        "description": "Automatic GitHub Action Updates",
        "matchUpdateTypes": [
            "minor",
            "patch"
        ],
        "matchPackageNames": [
            "actions/checkout",
            "actions/download-artifact",
            "actions/upload-artifact"
        ],
        "minimumReleaseAge": "3 days"
    }
  ]
}